# Used by docker-compose.yml (copy to .env next to it)

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=retail_market
MYSQL_USER=admin
MYSQL_PASSWORD=admin123
MYSQL_PORT=3306
PHPMYADMIN_PORT=8183

# App ports (host)
FRONTEND_PORT=3000
DASHBOARD_PORT=5173
BACKEND_PORT=8001

# Browser-facing URLs baked into frontend/dashboard builds (rebuild after changing)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173
NEXT_PUBLIC_MEDIA_URL=
# 1 = browsers load upload images directly (needed while the API URL is localhost)
NEXT_IMAGE_UNOPTIMIZED=1
VITE_API_URL=http://localhost:8001
VITE_APP_URL=http://localhost:5173
VITE_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Runtime secrets are read from the service env files:
#   backend container  ← backend/.env        (JWT_SECRET, SETTINGS_ENCRYPTION_KEY, ...)
#   frontend container ← frontend/.env.local (AUTH_SECRET)
# DATABASE_URL / INTERNAL_API_URL are set by docker-compose.yml for the Docker network.
