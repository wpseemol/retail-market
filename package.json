{
  "name": "retail-market",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter frontend --filter dashboard --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r --filter frontend --filter dashboard --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:dashboard": "pnpm --filter dashboard build",
    "build:backend": "pnpm --filter backend build",
    "lint": "pnpm -r --filter frontend --filter dashboard lint",
    "type-check": "pnpm -r --filter frontend --filter dashboard --filter backend exec tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
