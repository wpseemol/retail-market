# Copy this to `.env.dev` (pnpm dev) and `.env.prod` (pnpm build / pnpm start).
# A value already set on Vercel is kept.
# Public API URL used by the Vite admin dashboard.
# Local defaults. A Vercel build with these unset uses the live hosts:
# https://niyenin-api.wpseemol.site
# https://niyenin-dashboard.vercel.app
# https://niyenin-frontend.vercel.app
VITE_API_URL=http://localhost:8001
VITE_APP_URL=http://localhost:4173
VITE_STOREFRONT_URL=http://localhost:3000
# Server-only. The dev proxy and the Vercel function add these. Do not prefix with VITE_.
API_PUBLIC_KEY=
API_SECRET_KEY=
API_PROXY_TARGET=https://niyenin-api.wpseemol.site
