# Copy to .env.production (never commit that file).
# Passwords must not contain @ : / # or the MySQL URL will break.
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Public origins the browser uses. Rebuild after changing any of these.
STOREFRONT_URL=https://www.example.com
DASHBOARD_URL=https://admin.example.com
API_URL=https://api.example.com
# Extra origins if the site is also opened without www, comma-separated.
CORS_ORIGINS=https://www.example.com,https://admin.example.com

# Host ports. Set a BIND to 127.0.0.1 when a reverse proxy on this machine is the only public entry.
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0
DASHBOARD_PORT=5173
DASHBOARD_BIND=0.0.0.0
BACKEND_PORT=8001
BACKEND_BIND=0.0.0.0

# 0 once API_URL is a hostname the storefront container can reach.
# 1 only when API_URL is localhost (the image optimizer cannot call the host's localhost).
NEXT_IMAGE_UNOPTIMIZED=0
# Set to S3_PUBLIC_BASE_URL when STORAGE_DRIVER=s3, then rebuild the storefront.
NEXT_PUBLIC_MEDIA_URL=
GOOGLE_CLIENT_ID=

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=retail_market

# Each secret must be at least 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
AUTH_SECRET=
REVALIDATE_SECRET=

APP_NAME=Niyenin

# Media. local keeps uploads/ on the backend volume. s3 sends files to MinIO, R2, or AWS
# and the API will not start until the S3_* values are set.
STORAGE_DRIVER=local
S3_ENDPOINT=https://storage.niyenin.com
S3_REGION=auto
S3_BUCKET=niyenin-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://storage.niyenin.com/niyenin-media
