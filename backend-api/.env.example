# =============================================================================
# backend-api environment template
# =============================================================================
# Copy to `.env.dev` for local work and to `.env.prod` for the live API.
# The API loads `.env.dev`, or `.env.prod` when NODE_ENV=production.
# Prisma CLI still reads `.env` — keep that file equal to `.env.dev`.
#
# Generate long secrets (32+ bytes):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=8001
NODE_ENV=development

# --- MySQL ------------------------------------------------------------------
# Matches docker-compose defaults (container: retail_market_mysql).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@127.0.0.1:3306/retail_market"
# Set to 1 to log Prisma SQL in development.
# PRISMA_LOG_QUERIES=0

# --- Auth / JWT -------------------------------------------------------------
# Production refuses to start unless JWT_SECRET and SETTINGS_ENCRYPTION_KEY
# are each at least 32 bytes.
JWT_SECRET="change-me-to-a-long-random-secret"

# Access token (API Authorization header) — customers / default
JWT_ACCESS_EXPIRES_IN="1h"
# Customer refresh (storefront stay logged in) — ~1 year
JWT_REFRESH_EXPIRES_IN="365d"

# Elevated staff (super_admin / admin / moderator) — short for security
# Access ~15m; refresh ~1h idle window (no activity → must log in again)
JWT_STAFF_ACCESS_EXPIRES_IN="15m"
JWT_STAFF_REFRESH_EXPIRES_IN="1h"

# Vendor dashboard sessions
JWT_VENDOR_ACCESS_EXPIRES_IN="1h"
JWT_VENDOR_REFRESH_EXPIRES_IN="7d"

# Google Sign-In fallback (until Google is saved in Dashboard → Settings → Social login)
GOOGLE_CLIENT_ID=""

# Encrypts social login, SMS, WhatsApp, email, and payment secrets stored in the DB.
# Required in production; in development it defaults to JWT_SECRET.
# If an existing deployment never set it, set it to the current JWT_SECRET so
# saved secrets stay readable. Changing it later makes them unreadable.
SETTINGS_ENCRYPTION_KEY=""

# --- CORS & app keys --------------------------------------------------------
# Extra browser origins (comma-separated, no trailing slash).
# localhost + live Vercel apps are always allowed by the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:4173,http://localhost:5173,https://niyenin-frontend.vercel.app,https://niyenin-dashboard.vercel.app"

# Required in production (32+ bytes each). Same values on storefront + dashboard.
# Never put API_SECRET_KEY in a NEXT_PUBLIC_ or VITE_ variable.
API_PUBLIC_KEY=""
API_SECRET_KEY=""

# Same value as the storefront PROXY_IP_SECRET (server-only). Lets rate limits
# see each shopper when the storefront calls this API from Vercel.
PROXY_IP_SECRET=""

# --- Cache / rate limits ----------------------------------------------------
# Empty = in-memory store (correct for one Passenger process on Spaceship).
# Set an Upstash / Redis URL to share limits across workers.
REDIS_URL=""

# Whole-process caps for paid outbound messages (per hour).
EMAIL_MAX_PER_HOUR=200
SMS_MAX_PER_HOUR=40
WHATSAPP_MAX_PER_HOUR=40

# --- Public URLs ------------------------------------------------------------
# PUBLIC_API_URL must be reachable from the internet in production
# (SSLCOMMERZ posts callbacks + IPN here).
PUBLIC_API_URL="http://localhost:8001"
# Storefront origin — payment result redirect.
FRONTEND_URL="http://localhost:3000"
# Shared with frontend REVALIDATE_SECRET. When set, store/brand/SEO edits
# refresh the storefront cache instantly; empty = ~60s refresh.
REVALIDATE_SECRET=""

# --- SSLCOMMERZ (fallback) --------------------------------------------------
# Prefer Dashboard → Settings → Payment (encrypted in DB, overrides these).
# Leave SSLCZ_STORE_ID empty to disable online payment.
# SSLCZ_IS_LIVE=true → securepay.sslcommerz.com
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_IS_LIVE=false

# --- Branding / reviews -----------------------------------------------------
APP_NAME="Niyenin"
# true → new product reviews start as pending (moderation queue).
REVIEWS_REQUIRE_APPROVAL=false

# --- Email SMTP (fallback) --------------------------------------------------
# Prefer Dashboard → Settings → Email provider (encrypted in DB).
# Empty SMTP_HOST → verification codes are printed to the API console (dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Niyenin <no-reply@niyenin.com>"

# --- SMS (fallback) ---------------------------------------------------------
# Prefer Dashboard → Settings → SMS gateway (encrypted in DB).
# console | bulksmsbd
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_API_URL="https://bulksmsbd.net/api/smsapi"

# --- WhatsApp OTP (fallback) ------------------------------------------------
# Prefer Dashboard → Settings → WhatsApp (encrypted in DB).
# console | meta_cloud | twilio_whatsapp
WHATSAPP_PROVIDER="console"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCOUNT_SID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_API_VERSION="v21.0"
# false → do not send the OTP as a URL button parameter
WHATSAPP_TEMPLATE_BUTTON_PARAM=true

# --- Backups ----------------------------------------------------------------
# Dated folders under BACKUP_DIR/<YYYY-MM-DD_HHmm>/:
#   uploads-<stamp>.zip
#   database-<stamp>.sql.zip
#   manifest.json
# Super admin: Dashboard → Settings → Backups (Run backup now + download).
# Monthly cron also inbox-notifies every active super_admin when it finishes.
# Prefer system crontab on Passenger (process may sleep):
#   0 3 1 * * cd /path/to/backend-api && pnpm backup -- --notify
# In-process scheduler runs only when BACKUP_ENABLED=true (cron is UTC).
BACKUP_ENABLED=false
# minute hour day-of-month month weekday — default = 1st of each month, 03:00 UTC
BACKUP_CRON="0 3 1 * *"
# Keep ~13 months of monthly folders (delete older)
BACKUP_RETENTION_DAYS=400
BACKUP_DIR=backups

# --- Media storage ----------------------------------------------------------
# local = files under uploads/ (typical for development).
# s3    = stream resized images to MinIO / Cloudflare R2 / AWS S3 (no local copy).
# When STORAGE_DRIVER=s3 the API refuses to start if any S3_* value below is missing.
STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=s3:
# S3_ENDPOINT=https://storage.example.com
# S3_REGION=auto
# S3_BUCKET=niyenin-media
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# true for self-hosted MinIO; false is typical for AWS S3.
# S3_FORCE_PATH_STYLE=true
# Public URL prefix for objects (path-style MinIO includes the bucket).
# S3_PUBLIC_BASE_URL=https://storage.example.com/niyenin-media
