# Server
PORT=8001
NODE_ENV=development

# MySQL — matches docker-compose defaults (container: retail_market_mysql)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@127.0.0.1:3306/retail_market"

# Auth — production refuses to start unless JWT_SECRET and SETTINGS_ENCRYPTION_KEY are each 32+ bytes
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`).
JWT_SECRET="change-me-to-a-long-random-secret"
# Access token (API calls) — short-lived
JWT_ACCESS_EXPIRES_IN="1h"
# Refresh token (stay logged in) — ~1 year
JWT_REFRESH_EXPIRES_IN="365d"
# Google Sign-In fallback (used until Google is saved in Dashboard → Settings → Social login)
GOOGLE_CLIENT_ID=""
# Encrypts social login, SMS gateway and email provider secrets stored in the DB.
# Required in production; in development it defaults to JWT_SECRET. If an existing deployment
# never set it, set it to the current JWT_SECRET value so saved secrets stay readable.
# Changing it later makes saved secrets unreadable (re-enter them in the dashboard).
SETTINGS_ENCRYPTION_KEY=""
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
# Production: the Vercel storefront and dashboard origins, no trailing slash.
# CORS_ORIGINS="https://your-store.vercel.app,https://your-dashboard.vercel.app"

# Same value as the storefront PROXY_IP_SECRET (server-only). Lets login limits
# see each shopper when the storefront calls this API from Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_IP_SECRET=""
# Whole API process, per hour. Verification codes are also capped per phone/email.
SMS_MAX_PER_HOUR=40
EMAIL_MAX_PER_HOUR=200
WHATSAPP_MAX_PER_HOUR=40

# Public URLs. PUBLIC_API_URL must be reachable from the internet in production
# (SSLCOMMERZ posts callbacks + IPN to it). FRONTEND_URL = storefront (payment result redirect).
PUBLIC_API_URL="http://localhost:8001"
FRONTEND_URL="http://localhost:3000"
# Shared with frontend REVALIDATE_SECRET. When set, store/brand/SEO edits refresh the
# storefront cache instantly (POST {FRONTEND_URL}/api/revalidate); empty = 60 s refresh.
REVALIDATE_SECRET=""

# SSLCOMMERZ payment gateway (sandbox: https://developer.sslcommerz.com/registration/)
# Fallback only — once saved in Dashboard → Settings → Payment, the encrypted dashboard values win.
# Leave SSLCZ_STORE_ID empty to disable online payment. SSLCZ_IS_LIVE=true → securepay.sslcommerz.com
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_IS_LIVE=false

# Verification codes (email + SMS). Leave SMTP_HOST empty / SMS_PROVIDER=console in dev:
# codes are printed to the backend console instead of being sent.
APP_NAME="Niyenin"
# SMTP fallback — prefer Dashboard → Settings → Email provider (encrypted in DB, overrides these).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Niyenin <no-reply@niyenin.com>"
# SMS fallback — prefer Dashboard → Settings → SMS gateway (encrypted in DB, overrides these).
# console | bulksmsbd
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID=""

# Product reviews: true → new reviews wait in the dashboard queue as "pending" instead of going live.
REVIEWS_REQUIRE_APPROVAL=false

# Media storage. `local` keeps files under uploads/ (development).
# `s3` streams resized images to MinIO, Cloudflare R2, or AWS S3 and leaves nothing on this disk.
# The API refuses to start when STORAGE_DRIVER=s3 and any value below is missing.
STORAGE_DRIVER=s3
# Docker MinIO, https://<account>.r2.cloudflarestorage.com, or https://s3.<region>.amazonaws.com
S3_ENDPOINT=https://storage.niyenin.com
S3_REGION=auto
S3_BUCKET=niyenin-media
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
# true for self-hosted MinIO. false is typical for AWS S3.
S3_FORCE_PATH_STYLE=true
# Public URL prefix for objects. Path-style MinIO includes the bucket.
S3_PUBLIC_BASE_URL=https://storage.niyenin.com/niyenin-media
