generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Shared enums ───────────────────────────────────────────────

enum UserRole {
  super_admin
  admin
  moderator
  vendor
  customer
}

enum UserStatus {
  active
  inactive
  pending
  suspended
  banned
}

enum Gender {
  male
  female
  other
}

enum MediaDisk {
  local
  s3
  r2
  public
}

enum MediaCollection {
  product_images
  vendor_banners
  trade_licenses
  avatars
  site_banners
  review_images
  brand_banners
  showcase_og
}

enum DeviceType {
  desktop
  mobile
  tablet
  unknown
}

enum LoginMethod {
  password
  google
  facebook
  apple
  refresh
}

enum AddressType {
  shipping
  billing
  both
}

enum ProductStatus {
  draft
  active
  archived
  out_of_stock
}

/// Per-store storefront layout on the customer site.
enum StorefrontTheme {
  classic
  marketplace
  showcase
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash_on_delivery
  card
  mobile_banking
  bank_transfer
  wallet
  /// SSLCOMMERZ hosted checkout (bKash, Nagad, Rocket, cards, net banking).
  sslcommerz
}

enum OrderAddressType {
  shipping
  billing
}

// ─── Users & auth ───────────────────────────────────────────────

model User {
  id                        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  first_name                String     @db.VarChar(100)
  last_name                 String     @db.VarChar(100)
  username                  String?    @unique @db.VarChar(50)
  email                     String     @unique @db.VarChar(255)
  phone                     String?    @unique @db.VarChar(30)
  password                  String?    @db.VarChar(255)
  role                      UserRole   @default(customer)
  status                    UserStatus @default(active)
  gender                    Gender?
  date_of_birth             DateTime?  @db.Date
  email_verified_at         DateTime?
  phone_verified_at         DateTime?
  two_factor_secret         String?    @db.Text
  two_factor_recovery_codes String?    @db.Text
  two_factor_confirmed_at   DateTime?
  remember_token            String?    @db.VarChar(100)
  provider_name             String?    @db.VarChar(50)
  provider_id               String?    @db.VarChar(255)
  /// Primary profile image from `medias` (collection: avatars).
  avatar_id                 BigInt?    @unique @db.UnsignedBigInt
  /// Built-in SVG avatar key when no photo is uploaded (e.g. sprout, fox).
  avatar_preset             String?    @db.VarChar(40)
  last_login_at             DateTime?
  last_login_ip             String?    @db.VarChar(45)
  created_at                DateTime   @default(now())
  updated_at                DateTime   @updatedAt
  deleted_at                DateTime?

  avatar              Media?                @relation("UserAvatar", fields: [avatar_id], references: [id], onDelete: SetNull)
  uploadedMedia       Media[]               @relation("MediaUploader")
  sessions            UserSession[]
  addresses           CustomerAddress[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  productReviews      ProductReview[]       @relation("ProductReviewAuthor")
  moderatedReviews    ProductReview[]       @relation("ProductReviewModerator")
  notifications       Notification[]
  vendorProfile       Vendor?
  vendorHistory       VendorHistory[]       @relation("VendorHistoryActor")
  siteSettingsHistory SiteSettingsHistory[] @relation("SiteSettingsHistoryActor")
  verificationCodes   VerificationCode[]

  @@map("users")
}

enum VerificationChannel {
  email
  sms
}

/// One-time codes for verifying a customer's email / phone (hashed, short-lived).
model VerificationCode {
  id          BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt              @db.UnsignedBigInt
  channel     VerificationChannel
  /// Lowercased email or E.164 phone the code was sent to.
  target      String              @db.VarChar(255)
  code_hash   String              @db.VarChar(128)
  attempts    Int                 @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime            @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, channel])
  @@index([target, created_at])
  @@map("verification_codes")
}

model Media {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt?         @db.UnsignedBigInt
  disk            MediaDisk       @default(public)
  file_name       String          @db.VarChar(255)
  original_name   String?         @db.VarChar(255)
  file_path       String          @db.VarChar(500)
  file_size       BigInt?         @db.UnsignedBigInt
  mime_type       String?         @db.VarChar(100)
  dimensions      Json?
  alt_text        String?         @db.VarChar(255)
  collection_name MediaCollection
  is_public       Boolean         @default(true)
  mediable_type   String?         @db.VarChar(100)
  mediable_id     BigInt?         @db.UnsignedBigInt
  sort_order      Int             @default(0)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  uploader            User?            @relation("MediaUploader", fields: [user_id], references: [id], onDelete: SetNull)
  avatarForUsers      User[]           @relation("UserAvatar")
  categoryImages      Category[]       @relation("CategoryImage")
  brandImages         Brand[]          @relation("BrandImage")
  siteSettingsOg      SiteSettings[]   @relation("SiteSettingsOgImage")
  siteSettingsFavicon SiteSettings[]   @relation("SiteSettingsFavicon")
  siteSettingsLogin   SiteSettings[]   @relation("SiteSettingsLoginLogo")
  homeHeroMainProduct HomeHeroBanner[] @relation("HomeHeroMainProduct")
  homeHeroMainBg      HomeHeroBanner[] @relation("HomeHeroMainBg")
  homeHeroSideProduct HomeHeroBanner[] @relation("HomeHeroSideProduct")
  homeHeroSideBg      HomeHeroBanner[] @relation("HomeHeroSideBg")
  productThumbnails   Product[]        @relation("ProductThumbnail")
  variantImages       ProductVariant[] @relation("VariantImage")
  vendorLogos         Vendor[]         @relation("VendorLogo")
  vendorBanners       Vendor[]         @relation("VendorBanner")
  vendorOgImages      Vendor[]         @relation("VendorOgImage")
  brandBanners        Brand[]          @relation("BrandBanner")
  brandOgImages       Brand[]          @relation("BrandOgImage")

  @@index([user_id])
  @@index([collection_name])
  @@index([mediable_type, mediable_id])
  @@map("medias")
}

model UserSession {
  id               String      @id @default(uuid()) @db.Char(36)
  user_id          BigInt      @db.UnsignedBigInt
  token_hash       String      @unique @db.VarChar(64)
  ip_address       String?     @db.VarChar(45)
  /// ISO 3166-1 alpha-2 country from IP (LO = local/private).
  country          String?     @db.VarChar(2)
  user_agent       String?     @db.Text
  device_type      DeviceType  @default(unknown)
  browser          String?     @db.VarChar(100)
  os               String?     @db.VarChar(100)
  login_method     LoginMethod @default(password)
  is_revoked       Boolean     @default(false)
  last_activity_at DateTime    @default(now())
  created_at       DateTime    @default(now())
  expires_at       DateTime
  revoked_at       DateTime?
  updated_at       DateTime    @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([last_activity_at])
  @@index([expires_at])
  @@index([is_revoked])
  @@index([country])
  @@map("user_sessions")
}

// ─── Catalog ────────────────────────────────────────────────────

enum ProductType {
  simple
  variable
}

enum WeightUnit {
  g
  kg
  lb
  oz
}

model Category {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  parent_id        BigInt?   @db.UnsignedBigInt
  /// Category cover image from `medias` (collection: product_images).
  image_id         BigInt?   @unique @db.UnsignedBigInt
  /// Lucide SVG icon key for catalog display (e.g. "Smartphone").
  icon             String?   @db.VarChar(80)
  name             String    @db.VarChar(150)
  slug             String    @unique @db.VarChar(160)
  description      String?   @db.Text
  meta_title       String?   @db.VarChar(160)
  meta_description String?   @db.VarChar(320)
  is_active        Boolean   @default(true)
  sort_order       Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  image    Media?     @relation("CategoryImage", fields: [image_id], references: [id], onDelete: SetNull)
  products Product[]

  @@index([parent_id])
  @@index([is_active])
  @@index([sort_order])
  @@map("categories")
}

/// Shared product brands (create brands first, then assign on products).
model Brand {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// Brand logo / mark from `medias` (collection: product_images).
  image_id    BigInt?   @unique @db.UnsignedBigInt
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.VarChar(500)
  is_active   Boolean   @default(true)
  sort_order  Int       @default(0)
  /// Store whose vendor may customize this brand's showcase page (assigned by admins).
  vendor_id   BigInt?   @db.UnsignedBigInt
  /// Wide showcase banner (uploads/shops/, collection `brand_banners`).
  banner_id   BigInt?   @unique @db.UnsignedBigInt

  seo_title       String? @db.VarChar(70)
  seo_description String? @db.VarChar(170)
  seo_keywords    String? @db.VarChar(255)
  noindex         Boolean @default(false)
  og_image_id     BigInt? @unique @db.UnsignedBigInt
  tagline         String? @db.VarChar(160)
  /// Hex `#RRGGBB`; page accent in light and dark themes.
  accent_color    String? @db.VarChar(7)
  /// Layout, about, contact, social, policies, announcement (validated by `showcaseSchema`).
  showcase        Json?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  image    Media?    @relation("BrandImage", fields: [image_id], references: [id], onDelete: SetNull)
  banner   Media?    @relation("BrandBanner", fields: [banner_id], references: [id], onDelete: SetNull)
  og_image Media?    @relation("BrandOgImage", fields: [og_image_id], references: [id], onDelete: SetNull)
  vendor   Vendor?   @relation("VendorBrands", fields: [vendor_id], references: [id], onDelete: SetNull)
  products Product[]

  @@index([is_active])
  @@index([sort_order])
  @@index([vendor_id])
  @@map("brands")
}

model Vendor {
  id                      BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                 BigInt          @unique @db.UnsignedBigInt
  /// Store brand / logo image (uploads/shops/).
  logo_id                 BigInt?         @unique @db.UnsignedBigInt
  /// Wide storefront banner (uploads/shops/).
  banner_id               BigInt?         @unique @db.UnsignedBigInt
  shop_name               String          @db.VarChar(200)
  slug                    String          @unique @db.VarChar(220)
  description             String?         @db.Text
  status                  UserStatus      @default(pending)
  /// Customer /stores/[slug] layout theme.
  storefront_theme        StorefrontTheme @default(classic)
  /// How many products to list on the store page.
  products_per_page       Int             @default(12)
  /// Featured strip size (showcase / marketplace themes).
  featured_products_count Int             @default(4)
  /// Show products whose brand is inactive — styled as banned.
  show_banned_brands      Boolean         @default(true)
  /// Product ordering on the public store page.
  product_sort            String          @default("featured_first") @db.VarChar(32)

  seo_title       String? @db.VarChar(70)
  seo_description String? @db.VarChar(170)
  seo_keywords    String? @db.VarChar(255)
  noindex         Boolean @default(false)
  og_image_id     BigInt? @unique @db.UnsignedBigInt
  tagline         String? @db.VarChar(160)
  /// Hex `#RRGGBB`; page accent in light and dark themes.
  accent_color    String? @db.VarChar(7)
  /// Layout, about, contact, social, policies, announcement (validated by `showcaseSchema`).
  showcase        Json?

  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  deleted_at              DateTime?

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logo     Media?          @relation("VendorLogo", fields: [logo_id], references: [id], onDelete: SetNull)
  banner   Media?          @relation("VendorBanner", fields: [banner_id], references: [id], onDelete: SetNull)
  og_image Media?          @relation("VendorOgImage", fields: [og_image_id], references: [id], onDelete: SetNull)
  brands   Brand[]         @relation("VendorBrands")
  products Product[]
  history  VendorHistory[]

  @@map("vendors")
}

/// Audit trail for shop create / edit / logo / delete.
model VendorHistory {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  vendor_id  BigInt   @db.UnsignedBigInt
  actor_id   BigInt?  @db.UnsignedBigInt
  action     String   @db.VarChar(40)
  /// Field-level diffs, e.g. { shop_name: { from, to }, logo_id: { from, to } }
  changes    Json?
  note       String?  @db.VarChar(500)
  created_at DateTime @default(now())

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  actor  User?  @relation("VendorHistoryActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([vendor_id, created_at])
  @@index([actor_id])
  @@map("vendor_histories")
}

/// Parent sellable item. Price/stock on the product are used for `simple`
/// products; for `variable` products use `ProductVariant` rows instead.
model Product {
  id                  BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  vendor_id           BigInt?       @db.UnsignedBigInt
  category_id         BigInt?       @db.UnsignedBigInt
  brand_id            BigInt?       @db.UnsignedBigInt
  /// Primary thumbnail from `medias` (files under uploads/products/).
  thumbnail_id        BigInt?       @unique @db.UnsignedBigInt
  name                String        @db.VarChar(255)
  slug                String        @unique @db.VarChar(270)
  sku                 String?       @unique @db.VarChar(100)
  barcode             String?       @db.VarChar(64)
  /// Denormalized brand name (kept in sync with `brands.name`).
  brand               String?       @db.VarChar(120)
  description         String?       @db.Text
  short_description   String?       @db.VarChar(500)
  type                ProductType   @default(simple)
  price               Decimal       @db.Decimal(12, 2)
  compare_at_price    Decimal?      @db.Decimal(12, 2)
  cost_price          Decimal?      @db.Decimal(12, 2)
  stock_qty           Int           @default(0)
  low_stock_threshold Int?          @db.UnsignedInt
  weight              Decimal?      @db.Decimal(10, 3)
  weight_unit         WeightUnit    @default(kg)
  /// Per-product delivery charge (BDT). Null = site default, 0 = free shipping.
  shipping_fee        Decimal?      @db.Decimal(12, 2)
  status              ProductStatus @default(draft)
  is_featured         Boolean       @default(false)
  is_taxable          Boolean       @default(true)
  meta_title          String?       @db.VarChar(160)
  meta_description    String?       @db.VarChar(320)
  published_at        DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  deleted_at          DateTime?

  vendor         Vendor?          @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  category       Category?        @relation(fields: [category_id], references: [id], onDelete: SetNull)
  brandRef       Brand?           @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  thumbnail      Media?           @relation("ProductThumbnail", fields: [thumbnail_id], references: [id], onDelete: SetNull)
  options        ProductOption[]
  variants       ProductVariant[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  productReviews ProductReview[]

  @@index([vendor_id])
  @@index([category_id])
  @@index([brand_id])
  @@index([status])
  @@index([type])
  @@index([is_featured])
  @@index([published_at])
  @@map("products")
}

/// Option group on a product (e.g. Color, Size).
model ProductOption {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt   @db.UnsignedBigInt
  name       String   @db.VarChar(80)
  position   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([product_id, name])
  @@index([product_id, position])
  @@map("product_options")
}

/// Allowed value for an option (e.g. Red, XL).
model ProductOptionValue {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  option_id  BigInt   @db.UnsignedBigInt
  value      String   @db.VarChar(120)
  /// Optional swatch for color options.
  color_hex  String?  @db.VarChar(7)
  position   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  option   ProductOption          @relation(fields: [option_id], references: [id], onDelete: Cascade)
  variants ProductVariantOption[]

  @@unique([option_id, value])
  @@index([option_id, position])
  @@map("product_option_values")
}

/// Sellable SKU / stock unit (one row even for simple products).
model ProductVariant {
  id               BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  product_id       BigInt      @db.UnsignedBigInt
  /// Variant image from `medias` (collection: product_images, uploads/products/).
  image_id         BigInt?     @unique @db.UnsignedBigInt
  sku              String?     @unique @db.VarChar(100)
  barcode          String?     @db.VarChar(64)
  title            String?     @db.VarChar(255)
  price            Decimal?    @db.Decimal(12, 2)
  compare_at_price Decimal?    @db.Decimal(12, 2)
  cost_price       Decimal?    @db.Decimal(12, 2)
  stock_qty        Int         @default(0)
  weight           Decimal?    @db.Decimal(10, 3)
  weight_unit      WeightUnit?
  is_default       Boolean     @default(false)
  is_active        Boolean     @default(true)
  position         Int         @default(0)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  deleted_at       DateTime?

  product      Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  image        Media?                 @relation("VariantImage", fields: [image_id], references: [id], onDelete: SetNull)
  optionValues ProductVariantOption[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([product_id])
  @@index([product_id, is_default])
  @@index([is_active])
  @@map("product_variants")
}

/// Links a variant to its selected option values (Color=Red + Size=M).
model ProductVariantOption {
  id              BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  variant_id      BigInt @db.UnsignedBigInt
  option_value_id BigInt @db.UnsignedBigInt

  variant     ProductVariant     @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [option_value_id], references: [id], onDelete: Cascade)

  @@unique([variant_id, option_value_id])
  @@index([option_value_id])
  @@map("product_variant_options")
}

// ─── Customer addresses ─────────────────────────────────────────

model CustomerAddress {
  id                  BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  user_id             BigInt      @db.UnsignedBigInt
  label               String?     @db.VarChar(50)
  full_name           String      @db.VarChar(150)
  phone               String      @db.VarChar(30)
  line1               String      @db.VarChar(255)
  line2               String?     @db.VarChar(255)
  city                String      @db.VarChar(100)
  state               String?     @db.VarChar(100)
  postal_code         String      @db.VarChar(20)
  country             String      @default("BD") @db.VarChar(2)
  type                AddressType @default(both)
  is_default_shipping Boolean     @default(false)
  is_default_billing  Boolean     @default(false)
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  deleted_at          DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_default_shipping])
  @@index([user_id, is_default_billing])
  @@map("customer_addresses")
}

// ─── Cart ───────────────────────────────────────────────────────

model Cart {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @unique @db.UnsignedBigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cart_id            BigInt   @db.UnsignedBigInt
  product_id         BigInt   @db.UnsignedBigInt
  product_variant_id BigInt?  @db.UnsignedBigInt
  quantity           Int      @default(1)
  /// Included in checkout when true (cart page checkbox).
  selected           Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  cart    Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, product_id, product_variant_id])
  @@index([product_id])
  @@index([product_variant_id])
  @@map("cart_items")
}

// ─── Wishlist ───────────────────────────────────────────────────

model Wishlist {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @unique @db.UnsignedBigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  wishlist_id BigInt   @db.UnsignedBigInt
  product_id  BigInt   @db.UnsignedBigInt
  created_at  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([wishlist_id, product_id])
  @@index([product_id])
  @@map("wishlist_items")
}

// ─── Orders ─────────────────────────────────────────────────────

model Order {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  /// Null for guest checkout until claimed by a verified account.
  user_id         BigInt?       @db.UnsignedBigInt
  /// Lowercased contact email captured at checkout (guest + customer).
  customer_email  String?       @db.VarChar(255)
  /// Normalized E.164 contact phone captured at checkout (e.g. +8801712345678).
  customer_phone  String?       @db.VarChar(30)
  /// Set when a guest order is attached to an account after verification.
  claimed_at      DateTime?
  order_number    String        @unique @db.VarChar(40)
  status          OrderStatus   @default(pending)
  payment_status  PaymentStatus @default(pending)
  payment_method  PaymentMethod @default(cash_on_delivery)
  /// Wallet/card actually used on SSLCOMMERZ: bkash | nagad | rocket | card | other (null until paid).
  payment_channel String?       @db.VarChar(20)
  courier_name    String?       @db.VarChar(80)
  tracking_number String?       @db.VarChar(80)
  currency        String        @default("BDT") @db.VarChar(3)
  subtotal        Decimal       @db.Decimal(12, 2)
  shipping_fee    Decimal       @default(0) @db.Decimal(12, 2)
  discount_amount Decimal       @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  notes           String?       @db.Text
  placed_at       DateTime      @default(now())
  shipped_at      DateTime?
  delivered_at    DateTime?
  cancelled_at    DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  user      User?           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  items     OrderItem[]
  addresses OrderAddress[]
  payments  Payment[]
  reviews   ProductReview[]

  @@index([user_id])
  @@index([customer_email])
  @@index([customer_phone])
  @@index([status])
  @@index([payment_status])
  @@index([payment_method, payment_channel])
  @@index([placed_at])
  @@map("orders")
}

model OrderItem {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  order_id           BigInt   @db.UnsignedBigInt
  product_id         BigInt?  @db.UnsignedBigInt
  product_variant_id BigInt?  @db.UnsignedBigInt
  product_name       String   @db.VarChar(255)
  product_sku        String?  @db.VarChar(100)
  variant_title      String?  @db.VarChar(255)
  unit_price         Decimal  @db.Decimal(12, 2)
  quantity           Int
  line_total         Decimal  @db.Decimal(12, 2)
  created_at         DateTime @default(now())

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([product_id])
  @@index([product_variant_id])
  @@map("order_items")
}

/// Snapshot of shipping/billing at checkout (edits to customer_addresses won't rewrite history).
model OrderAddress {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  order_id    BigInt           @db.UnsignedBigInt
  type        OrderAddressType
  full_name   String           @db.VarChar(150)
  phone       String           @db.VarChar(30)
  line1       String           @db.VarChar(255)
  line2       String?          @db.VarChar(255)
  city        String           @db.VarChar(100)
  state       String?          @db.VarChar(100)
  postal_code String           @db.VarChar(20)
  country     String           @default("BD") @db.VarChar(2)
  created_at  DateTime         @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, type])
  @@map("order_addresses")
}

model Payment {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  order_id         BigInt        @db.UnsignedBigInt
  method           PaymentMethod
  status           PaymentStatus @default(pending)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("BDT") @db.VarChar(3)
  transaction_id   String?       @db.VarChar(150)
  provider         String?       @db.VarChar(50)
  provider_payload Json?
  paid_at          DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([status])
  @@index([transaction_id])
  @@map("payments")
}

// ─── Reviews & notifications ────────────────────────────────────

model Review {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt   @db.UnsignedBigInt
  product_id  BigInt   @db.UnsignedBigInt
  rating      Int
  title       String?  @db.VarChar(150)
  body        String?  @db.Text
  is_approved Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([product_id])
  @@index([is_approved])
  @@map("reviews")
}

enum ProductReviewStatus {
  pending
  approved
  hidden
  rejected
}

/// Purchase-verified review: every row is tied to a paid + delivered order containing the product.
model ProductReview {
  id                   BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  product_id           BigInt              @db.UnsignedBigInt
  /// Set when the order belongs to a customer account (null for guest orders).
  user_id              BigInt?             @db.UnsignedBigInt
  order_id             BigInt              @db.UnsignedBigInt
  author_name          String              @db.VarChar(150)
  /// Lowercased email the reviewer verified with.
  author_email         String?             @db.VarChar(255)
  /// E.164 phone the reviewer verified with.
  author_phone         String?             @db.VarChar(30)
  rating               Int                 @db.UnsignedTinyInt
  title                String?             @db.VarChar(150)
  comment              String              @db.Text
  /// Ordered `medias.id` list (collection: review_images, uploads/reviews/).
  images               Json?
  is_verified_purchase Boolean             @default(true)
  status               ProductReviewStatus @default(approved)
  /// Staff flag for a second look (moderators flag, admins decide).
  flagged_at           DateTime?
  flag_reason          String?             @db.VarChar(255)
  moderated_by         BigInt?             @db.UnsignedBigInt
  moderated_at         DateTime?
  vendor_reply         String?             @db.Text
  vendor_replied_at    DateTime?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  deleted_at           DateTime?

  product   Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user      User?   @relation("ProductReviewAuthor", fields: [user_id], references: [id], onDelete: SetNull)
  order     Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  moderator User?   @relation("ProductReviewModerator", fields: [moderated_by], references: [id], onDelete: SetNull)

  @@unique([order_id, product_id])
  @@index([product_id, status])
  @@index([user_id])
  @@index([author_email])
  @@index([author_phone])
  @@index([status, created_at])
  @@index([moderated_by])
  @@index([deleted_at])
  @@map("product_reviews")
}

model Notification {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  type       String    @db.VarChar(80)
  title      String    @db.VarChar(200)
  body       String?   @db.Text
  data       Json?
  read_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@index([created_at])
  @@map("notifications")
}

/// Singleton website SEO + analytics / pixel config (id = 1).
model SiteSettings {
  id               Int     @id @default(1)
  site_name        String  @db.VarChar(120)
  site_title       String  @db.VarChar(160)
  site_description String  @db.VarChar(500)
  keywords         String? @db.VarChar(500)

  og_title       String? @db.VarChar(160)
  og_description String? @db.VarChar(500)
  og_image_id    BigInt? @unique @db.UnsignedBigInt
  /// Browser tab / bookmark icon.
  favicon_id     BigInt? @unique @db.UnsignedBigInt
  /// Logo shown on dashboard (and storefront) login screens.
  login_logo_id  BigInt? @unique @db.UnsignedBigInt

  twitter_title       String? @db.VarChar(160)
  twitter_description String? @db.VarChar(500)
  twitter_handle      String? @db.VarChar(80)

  /// e.g. `%s | Niyenin`; `%s` is replaced by the page title.
  seo_title_template       String? @db.VarChar(120)
  /// Blocks indexing of the whole storefront (staging).
  seo_noindex_site         Boolean @default(false)
  google_site_verification String? @db.VarChar(120)
  bing_site_verification   String? @db.VarChar(120)
  /// Default title/description per index page: { home, shop, stores, brands }.
  seo_pages                Json?

  google_analytics_id        String? @db.VarChar(40)
  google_analytics_enabled   Boolean @default(false)
  google_tag_manager_id      String? @db.VarChar(40)
  google_tag_manager_enabled Boolean @default(false)
  hotjar_site_id             String? @db.VarChar(40)
  hotjar_enabled             Boolean @default(false)
  plerdy_site_id             String? @db.VarChar(80)
  plerdy_enabled             Boolean @default(false)

  google_ads_id         String? @db.VarChar(40)
  google_ads_enabled    Boolean @default(false)
  tiktok_pixel_id       String? @db.VarChar(80)
  tiktok_enabled        Boolean @default(false)
  linkedin_partner_id   String? @db.VarChar(40)
  linkedin_enabled      Boolean @default(false)
  twitter_pixel_id      String? @db.VarChar(80)
  twitter_pixel_enabled Boolean @default(false)
  meta_pixel_id         String? @db.VarChar(40)
  meta_pixel_enabled    Boolean @default(false)

  /// Storefront /shop catalog defaults (grid4|grid3|grid2|list).
  shop_default_view       String @default("grid4") @db.VarChar(16)
  /// How many products to show per page on /shop.
  shop_products_per_page  Int    @default(12)
  /// Sidebar: how many categories shown before “See all”.
  shop_categories_visible Int    @default(5)
  /// Sidebar: how many brands shown before “See all”.
  shop_brands_visible     Int    @default(6)
  /// Sidebar expand button label.
  shop_see_all_label      String @default("See all") @db.VarChar(40)
  /// Sidebar collapse button label.
  shop_show_less_label    String @default("Show less") @db.VarChar(40)

  /// Delivery charge (BDT) for products without their own shipping fee.
  shipping_default_fee     Decimal  @default(60) @db.Decimal(12, 2)
  /// Order subtotal at/above which the whole order ships free. Null = never.
  shipping_free_threshold  Decimal? @db.Decimal(12, 2)
  /// Store owners (vendors) may set a per-product shipping fee.
  shipping_vendor_override Boolean  @default(true)

  /// Top bar + footer chrome (storefront header/footer).
  topbar_email     String? @db.VarChar(160)
  topbar_phone     String? @db.VarChar(40)
  footer_blurb     String? @db.VarChar(500)
  footer_phone     String? @db.VarChar(40)
  footer_callout   String? @db.VarChar(120)
  social_facebook  String? @db.VarChar(300)
  social_twitter   String? @db.VarChar(300)
  social_youtube   String? @db.VarChar(300)
  social_linkedin  String? @db.VarChar(300)
  social_instagram String? @db.VarChar(300)

  updated_at DateTime @updatedAt

  og_image      Media?                @relation("SiteSettingsOgImage", fields: [og_image_id], references: [id], onDelete: SetNull)
  favicon       Media?                @relation("SiteSettingsFavicon", fields: [favicon_id], references: [id], onDelete: SetNull)
  login_logo    Media?                @relation("SiteSettingsLoginLogo", fields: [login_logo_id], references: [id], onDelete: SetNull)
  history       SiteSettingsHistory[]
  nav_items     SiteNavItem[]
  home_sections HomeSection[]

  @@map("site_settings")
}

/// Storefront social sign-in credentials. Secrets are AES-256-GCM encrypted
/// (`lib/secretBox.ts`) and never returned without password re-auth.
model SocialLoginProvider {
  /// google | facebook | apple
  provider          String   @id @db.VarChar(20)
  is_enabled        Boolean  @default(false)
  /// Google OAuth client ID / Facebook App ID / Apple Services ID.
  client_id         String?  @db.VarChar(255)
  client_secret_enc String?  @db.Text
  /// Apple only.
  team_id           String?  @db.VarChar(20)
  key_id            String?  @db.VarChar(20)
  private_key_enc   String?  @db.Text
  updated_by        BigInt?  @db.UnsignedBigInt
  updated_at        DateTime @updatedAt

  @@map("social_login_providers")
}

/// SMS gateway credentials managed from Dashboard → Settings → SMS gateway (super_admin).
/// At most one row is active; with none active, sending falls back to SMS_* env vars.
model SmsGatewayProvider {
  /// bulksmsbd | alpha_sms | ssl_wireless | mim_sms | twilio
  provider    String   @id @db.VarChar(20)
  is_active   Boolean  @default(false)
  /// API key / API token / Twilio auth token (AES-256-GCM).
  api_key_enc String?  @db.Text
  /// Sender ID / SSL SID / MiM sender name / Twilio From number or Messaging Service SID.
  sender_id   String?  @db.VarChar(40)
  /// Twilio Account SID / MiM SMS panel login email.
  account_sid String?  @db.VarChar(255)
  updated_by  BigInt?  @db.UnsignedBigInt
  updated_at  DateTime @updatedAt

  @@map("sms_gateway_providers")
}

/// Online payment gateway credentials managed from dashboard settings.
model PaymentGateway {
  /// sslcommerz
  provider           String   @id @db.VarChar(20)
  is_enabled         Boolean  @default(false)
  store_id           String?  @db.VarChar(100)
  /// Store password / API secret (AES-256-GCM).
  store_password_enc String?  @db.Text
  /// false = sandbox.
  is_live            Boolean  @default(false)
  updated_by         BigInt?  @db.UnsignedBigInt
  updated_at         DateTime @updatedAt

  @@map("payment_gateways")
}

/// Outgoing email (verification codes etc.) managed from Dashboard → Settings → Email provider.
/// Every preset sends over SMTP. With none active, sending falls back to SMTP_* env vars.
model EmailProvider {
  /// gmail | zoho | sendgrid | brevo | mailgun | smtp
  provider     String   @id @db.VarChar(20)
  is_active    Boolean  @default(false)
  /// Custom SMTP only — presets use fixed hosts.
  host         String?  @db.VarChar(255)
  port         Int?
  secure       Boolean?
  username     String?  @db.VarChar(255)
  /// SMTP password / app password / API key (AES-256-GCM).
  password_enc String?  @db.Text
  from_email   String?  @db.VarChar(255)
  from_name    String?  @db.VarChar(100)
  updated_by   BigInt?  @db.UnsignedBigInt
  updated_at   DateTime @updatedAt

  @@map("email_providers")
}

/// Header / footer menu links (ordered; drag-drop position in dashboard).
model SiteNavItem {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  settings_id Int      @default(1)
  /// header | footer_find | footer_care | footer_sell
  menu        String   @db.VarChar(32)
  label       String   @db.VarChar(120)
  href        String   @db.VarChar(500)
  external    Boolean  @default(false)
  position    Int      @default(0)
  is_enabled  Boolean  @default(true)
  /// Optional parent for dropdown children (header only).
  parent_id   BigInt?  @db.UnsignedBigInt
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  settings SiteSettings  @relation(fields: [settings_id], references: [id], onDelete: Cascade)
  parent   SiteNavItem?  @relation("SiteNavChildren", fields: [parent_id], references: [id], onDelete: Cascade)
  children SiteNavItem[] @relation("SiteNavChildren")

  @@index([settings_id, menu, position])
  @@index([parent_id])
  @@map("site_nav_items")
}

/// Home page section visibility + order (component-wise).
model HomeSection {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  settings_id Int      @default(1)
  /// Stable key matching frontend component (hero, featured, …).
  key         String   @db.VarChar(64)
  label       String   @db.VarChar(120)
  position    Int      @default(0)
  is_enabled  Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  settings SiteSettings @relation(fields: [settings_id], references: [id], onDelete: Cascade)

  @@unique([settings_id, key])
  @@index([settings_id, position])
  @@map("home_sections")
}

/// Per-section CMS JSON for home page blocks (hero uses home_hero_banners).
model HomeBlockContent {
  id         Int      @id @default(autoincrement())
  /// Matches home_sections.key (welcome_modal, featured, …).
  key        String   @unique @db.VarChar(64)
  content    Json
  updated_at DateTime @updatedAt

  @@map("home_block_contents")
}

/// Singleton home page hero + side promo content (id = 1).
model HomeHeroBanner {
  id Int @id @default(1)

  main_eyebrow          String  @default("Widescreen 4k .......") @db.VarChar(120)
  main_headline         String  @default("DIGITAL SLR CAMERA HIGH DEFINITION") @db.VarChar(200)
  main_subtext          String? @db.VarChar(300)
  main_discount_percent Int?    @default(70)
  main_price_label      String? @db.VarChar(40)
  main_cta_label        String  @default("SHOP NOW") @db.VarChar(40)
  main_cta_href         String  @default("/shop") @db.VarChar(300)
  main_product_image_id BigInt? @unique @db.UnsignedBigInt
  main_bg_image_id      BigInt? @unique @db.UnsignedBigInt

  side_badge_label      String? @db.VarChar(40)
  side_offer_percent    Int?    @default(25)
  side_offer_label      String? @default("offer") @db.VarChar(40)
  side_headline         String  @default("CLOUD CAM, SECURITY CAMERA") @db.VarChar(200)
  side_discount_percent Int?    @default(70)
  side_cta_label        String  @default("SHOP NOW") @db.VarChar(40)
  side_cta_href         String  @default("/shop") @db.VarChar(300)
  side_product_image_id BigInt? @unique @db.UnsignedBigInt
  side_bg_image_id      BigInt? @unique @db.UnsignedBigInt

  updated_at DateTime @updatedAt

  main_product_image Media? @relation("HomeHeroMainProduct", fields: [main_product_image_id], references: [id], onDelete: SetNull)
  main_bg_image      Media? @relation("HomeHeroMainBg", fields: [main_bg_image_id], references: [id], onDelete: SetNull)
  side_product_image Media? @relation("HomeHeroSideProduct", fields: [side_product_image_id], references: [id], onDelete: SetNull)
  side_bg_image      Media? @relation("HomeHeroSideBg", fields: [side_bg_image_id], references: [id], onDelete: SetNull)

  @@map("home_hero_banners")
}

/// Audit trail for site settings create / edit / OG image / clear.
model SiteSettingsHistory {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// Always points at the singleton site_settings row (id = 1).
  settings_id Int      @default(1)
  actor_id    BigInt?  @db.UnsignedBigInt
  action      String   @db.VarChar(40)
  /// Field-level diffs, e.g. { site_name: { from, to } }
  changes     Json?
  note        String?  @db.VarChar(500)
  created_at  DateTime @default(now())

  settings SiteSettings @relation(fields: [settings_id], references: [id], onDelete: Cascade)
  actor    User?        @relation("SiteSettingsHistoryActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([settings_id, created_at])
  @@index([actor_id])
  @@map("site_settings_histories")
}

/// Anonymous storefront page hits for visitor-by-country analytics.
model PageVisit {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  /// ISO 3166-1 alpha-2 (LO = local/private, XX = unknown).
  country     String     @db.VarChar(2)
  path        String     @db.VarChar(255)
  referrer    String?    @db.VarChar(500)
  /// Hashed IP only — never store raw visitor IPs for analytics.
  ip_hash     String?    @db.VarChar(64)
  device_type DeviceType @default(unknown)
  created_at  DateTime   @default(now())

  @@index([created_at])
  @@index([country, created_at])
  @@map("page_visits")
}
