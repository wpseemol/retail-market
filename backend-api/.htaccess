# Used when Passenger is not serving the Node app.
# If cPanel wrote a "CLOUDLINUX PASSENGER CONFIGURATION" block into this
# file, keep that block under these rules. Do not delete it.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Hidden files (.env, .env.prod, .env.dev) and the project folders.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(src|prisma|node_modules|dist)(/|$) - [F,L]
  RewriteRule \.(json|md|ts|tsx|map|sql|yml|yaml|toml|lock|prisma|pem|key|log)$ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^\.env">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(json|md|ts|tsx|map|sql|yml|yaml|toml|lock|prisma|pem|key|log)$">
    Require all denied
  </FilesMatch>
  <Files "index.html">
    Require all granted
  </Files>
</IfModule>
